{% extends "base.html.twig" %}

{% block title %}Accueil - Sanctuaire{% endblock %}

{% block body %}
<div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-lg mt-4">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold">Bienvenue, Nephalem</h1>
        <p class="col-md-8 fs-4">Explorez les meilleurs builds de Sanctuaire ou partagez vos propres stratégies avec la communauté.</p>
        
        <div class="d-grid gap-2 d-md-flex justify-content-md-start mt-4">
            <a href="/builds" class="btn btn-primary btn-lg px-4 me-md-2">Explorer les Builds</a>
            
            {% if session.user is not defined %}
                <a href="/register" class="btn btn-outline-light btn-lg px-4">Rejoindre la Forge</a>
            {% else %}
                <a href="/builds/create" class="btn btn-success btn-lg px-4">Créer un Build</a>
            {% endif %}
        </div>
    </div>
</div>

<div class="row align-items-md-stretch">
    <div class="col-md-6">
        <div class="h-100 p-5 text-white  rounded-3 card-last-builds">
            <h2>Derniers Builds</h2>
            <p>Consultez les dernières optimisations pour Diablo II, Diablo III, et Diablo IV.</p>
            <a class="btn btn-outline-light" href="/builds">Voir la liste</a>
        </div>
    </div>
    <div class="col-md-6">
        {% if session.user is defined and session.user.role == 'admin' %}
            <div class="h-100 p-5 bg-light border rounded-3">
                <h2>Administration</h2>
                <p>Gérez les utilisateurs et les builds signalés par la communauté.</p>
                <a class="btn btn-outline-secondary" href="/admin/dashboard">Accéder au Panel</a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}