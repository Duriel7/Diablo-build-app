{% extends "base.html.twig" %}

{% block title %}Répertoire des Builds - {{ parent() }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-gold">Répertoire des Builds</h1>
    {% if session.user is defined %}
        <a href="/builds/create" class="btn btn-primary">Forger un Build</a>
    {% endif %}
</div>

<div class="card bg-dark border-secondary mb-4">
    <div class="card-body">
        <form method="GET" action="/builds" class="row g-2">
            <div class="col-md-10">
                <input type="text" class="form-control" name="search" value="{{ searchTerm|default('') }}" placeholder="Rechercher un build, une classe (Barbare, Sorcier...)...">
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-warning">Rechercher</button>
            </div>
        </form>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    {% for build in builds %}
        <div class="col">
            <div class="card h-100 bg-dark text-white border-secondary shadow">
                <img src="{{ build.imageFileName ? '/uploads/builds/' ~ build.imageRepository ~ '/' ~ build.imageFileName : 'https://placehold.co/600x400/1a1a1a/c5a059?text=Diablo+Build' }}" 
                    class="card-img-top" 
                    alt="{{ build.name }}"
                    style="object-fit: cover; height: 200px;">
                
                <div class="card-body">
                    <h3 class="card-title text-gold">{{ build.name }}</h3>
                    <span class="badge bg-danger mb-2">{{ build.characterClass }}</span>
                    <p class="small text-muted mb-2">Jeu : {{ build.game }}</p>
                    <p class="card-text text-truncate">{{ build.description|striptags }}</p>
                </div>
                <div class="card-footer border-secondary bg-transparent">
                    <a href="/builds/{{ build.id }}" class="btn btn-sm btn-outline-light w-100">Voir les détails</a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <p class="fs-4 text-muted">Aucun build n'a encore été forgé dans le Sanctuaire.</p>
        </div>
    {% endfor %}
    {% if totalPages > 1 %}
        <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                    <a class="page-item bg-dark border-secondary text-gold p-2" href="?page={{ currentPage - 1 }}&search={{ searchTerm }}">Précédent</a>
                </li>
                
                <li class="page-item disabled">
                    <span class="page-link bg-dark border-secondary text-light">Page {{ currentPage }} sur {{ totalPages }}</span>
                </li>

                <li class="page-item {{ currentPage == totalPages ? 'disabled' : '' }}">
                    <a class="page-item bg-dark border-secondary text-gold p-2" href="?page={{ currentPage + 1 }}&search={{ searchTerm }}">Suivant</a>
                </li>
            </ul>
        </nav>
        {% endif %}
</div>
{% endblock %}