{% extends "base.html.twig" %}

{% block title %}Répertoire des Builds - {{ parent() }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-gold">Répertoire des Builds</h1>
    {% if session.user is defined %}
        <a href="/builds/create" class="btn btn-primary">Forger un Build</a>
    {% endif %}
</div>

<div class="card bg-dark border-secondary mb-4">
    <div class="card-body">
        <form method="GET" action="/builds" class="row g-2">
            <div class="col-md-10">
                <input type="text" class="form-control" name="search" value="{{ searchTerm|default('') }}" placeholder="Rechercher un build, une classe (Barbare, Sorcier...)...">
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-warning">Rechercher</button>
            </div>
        </form>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    {% for build in builds %}
        <div class="col">
            <div class="card h-100 bg-dark text-white border-secondary shadow">
                <img src="{{ build.imageFileName ? '/uploads/builds/' ~ build.imageRepository ~ '/' ~ build.imageFileName : 'https://placehold.co/600x400/1a1a1a/c5a059?text=Diablo+Build' }}" 
                    class="card-img-top" 
                    alt="{{ build.name }}"
                    style="object-fit: cover; height: 200px;">
                
                <div class="card-body">
                    <h3 class="card-title text-gold">{{ build.name }}</h3>
                    <span class="badge bg-danger mb-2">{{ build.characterClass }}</span>
                    <p class="small text-muted mb-2">Jeu : {{ build.game }}</p>
                    <p class="card-text text-truncate">{{ build.description|striptags }}</p>
                </div>
                <div class="card-footer border-secondary bg-transparent">
                    <a href="/builds/{{ build.id }}" class="btn btn-sm btn-outline-light w-100">Voir les détails</a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <p class="fs-4 text-muted">Aucun build n'a encore été forgé dans le Sanctuaire.</p>
        </div>
    {% endfor %}
</div>
    
    <div class="container-fluid d-flex justify-content-center my-5">
        {% if totalPages > 1 %}
            <div class="d-flex justify-content-center align-items-center gap-3 my-5">
                {% if currentPage > 1 %}
                    <a href="?page={{ currentPage - 1 }}&search={{ searchTerm }}" 
                    class="btn btn-outline-warning border-gold text-gold px-4 py-2 shadow-lg" 
                    style="border-width: 2px; transition: 0.3s;">
                    <i class="bi bi-chevron-left"></i> Précédent
                    </a>
                {% else %}
                    <button class="btn btn-outline-secondary disabled px-4 py-2" style="opacity: 0.5;">
                        <i class="bi bi-chevron-left"></i> Précédent
                    </button>
                {% endif %}

                <div class="px-3 py-2 bg-dark border border-secondary rounded shadow-inner">
                    <span class="text-white fw-bold">PAGE</span>
                    <span class="text-gold h5 mb-0 mx-2">{{ currentPage }}</span>
                    <span class="text-muted">/ {{ totalPages }}</span>
                </div>
                
                {% if currentPage < totalPages %}
                    <a href="?page={{ currentPage + 1 }}&search={{ searchTerm }}" 
                    class="btn btn-outline-warning border-gold text-gold px-4 py-2 shadow-lg"
                    style="border-width: 2px; transition: 0.3s;">
                    Suivant <i class="bi bi-chevron-right"></i>
                    </a>
                {% else %}
                    <button class="btn btn-outline-secondary disabled px-4 py-2" style="opacity: 0.5;">
                        Suivant <i class="bi bi-chevron-right"></i>
                    </button>
                {% endif %}
            </div>
        {% endif %}
    </div>
    <style>
        .text-gold { color: #c5a059 !important; }
        
        .btn-diablo-gold {
            background-color: transparent;
            color: #c5a059;
            border: 2px solid #c5a059;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .btn-diablo-gold:hover {
            background-color: #c5a059;
            color: #1a1a1a;
            box-shadow: 0 0 15px rgba(197, 160, 89, 0.4);
            transform: translateY(-2px);
        }

        .btn-diablo-disabled {
            background-color: transparent;
            color: #555;
            border: 2px solid #333;
            text-transform: uppercase;
            cursor: not-allowed;
        }

        .pagination-counter {
            background: rgba(0, 0, 0, 0.6);
            border: 1px solid #333;
            border-radius: 4px;
            box-shadow: inset 0 0 10px #000;
        }
    </style>
</div>
{% endblock %}