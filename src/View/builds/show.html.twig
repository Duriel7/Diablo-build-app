{% extends "base.html.twig" %}

{% block title %}{{ build.name }} - {{ parent() }}{% endblock %}

{% block body %}
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/builds" class="text-gold">Répertoire</a></li>
    <li class="breadcrumb-item active text-light" aria-current="page">{{ build.name }}</li>
  </ol>
</nav>

<div class="row g-5">
    <div class="col-md-4">
        <div class="card bg-dark border-secondary text-white shadow">
            <img src="{{ build.imageFileName ? '/uploads/' ~ build.imageFileName : 'https://placehold.co/600x400/1a1a1a/c5a059?text=Diablo+Build' }}" class="card-img-top" alt="{{ build.name }}">
            <div class="card-body">
                <h5 class="text-gold">{{ build.characterClass }}</h5>
                <p class="badge bg-danger">{{ build.game }}</p>
                <p class="small text-muted">Créé le : {{ build.createdAt|date('d/m/Y') }}</p>
                <p>Par : <a href="/user/{{ build.authorId }}" class="text-gold">{{ author.nickname }}</a></p>
                <p class="small text-muted">Version : {{ build.version }}</p>
            </div>
        </div>
        
        <div class="mt-4 d-grid gap-2">
            {% if session.user is defined %}
                <form action="/builds/report/{{ build.id }}" method="POST">
                    <a href="/builds/download/{{ build.id }}" class="btn btn-outline-warning w-100">
                        <i class="bi bi-file-earmark-pdf"></i> Télécharger la fiche (PDF)
                    </a>
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-exclamation-triangle"></i> Signaler ce build (envoie un mail avec PDF)
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="col-md-8">
        <h1 class="text-gold display-4 mb-3">{{ build.name }}</h1>
        <div class="p-4 bg-dark rounded border border-secondary shadow-sm">
            <h3 class="h5 text-gold border-bottom border-secondary pb-2 mb-3">Description du Build</h3>
            <div class="text-light" style="white-space: pre-wrap;">
                {{ build.description|raw }}
            </div>
        </div>
        {% if session.user is defined and (session.user.id == build.authorId or session.user.role == 'admin') %}
            <div class="admin-actions mt-3">
                <a href="/builds/edit/{{ build.id }}" class="btn btn-warning">Modifier</a>
                <form action="/builds/delete/{{ build.id }}" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Supprimer ?')">Supprimer</button>
                </form>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}