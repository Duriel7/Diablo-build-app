{% extends "base.html.twig" %}

{% block title %}Créer un nouveau Build - {{ parent() }}{% endblock %}

{% block body %}
<section class="container mt-5">
    <h1 class="mb-4">Forger un nouveau Build</h1>

    <form method="post" action="/builds/create" class="needs-validation">
        
        <div class="mb-3">
            <label for="name" class="form-label">Nom du Build :</label>
            <input type="text" class="form-control" id="name" name="name" placeholder="Ex: Barbare Trombe 2.0" required>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="characterClass" class="form-label">Classe :</label>
                <select class="form-select" id="characterClass" name="characterClass" required>
                    <option value="" selected disabled>Choisissez une classe</option>
                    <option value="Barbare">Barbare</option>
                    <option value="Sorcier">Sorcier</option>
                    <option value="Druide">Druide</option>
                    <option value="Voleur">Voleur</option>
                    <option value="Nécromancien">Nécromancien</option>
                    <option value="Féticheur">Féticheur</option>
                    <option value="Croisé">Croisé</option>
                    <option value="Moine">Moine</option>
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label for="game" class="form-label">Jeu :</label>
                <select class="form-select" id="game" name="game" required>
                    <option value="Diablo IV">Diablo IV</option>
                    <option value="Diablo III">Diablo III</option>
                    <option value="Diablo II: Resurrected">Diablo II: Resurrected</option>
                    <option value="Diablo Immortal">Diablo Immortal</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description et stratégie :</label>
            <textarea class="form-control" id="description" name="description" rows="6" placeholder="Expliquez les compétences, l'équipement et la rotation de sorts..."></textarea>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <a href="/builds" class="btn btn-secondary me-md-2">Annuler</a>
            <button type="submit" class="btn btn-primary">Publier le Build</button>
        </div>
    </form>
</section>
{% endblock %}