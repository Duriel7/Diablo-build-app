{% extends "base.html.twig" %}

{% block title %}Inscription - Sanctuaire{% endblock %}

{% block body %}
<section class="auth-form">
    <h1>Rejoindre Sanctuaire</h1>

    {% if error %}
        <div class="alert alert-danger" role="alert">{{ error }}</div>
    {% endif %}

    <form action="/register" method="POST">
        <div class="form-group">
            <label for="nickname">Nom de héros (Nickname) :</label>
            <input type="text" id="nickname" name="nickname" required aria-required="true">
        </div>

        <div class="form-group">
            <label for="email">Adresse e-mail :</label>
            <input type="email" id="email" name="email" required aria-required="true">
        </div>

        <div class="form-group">
            <label for="password">Mot de passe :</label>
            <input type="password" id="password" name="password" required aria-required="true">
        </div>

        <div class="form-group">
            <label for="city">Ville (pour la proximité des joueurs) :</label>
            <input type="text" id="city" name="city" required aria-required="true">
        </div>

        <div class="form-group">
            <label for="bio">Votre histoire (Bio) :</label>
            <textarea id="bio" name="bio" rows="4"></textarea>
        </div>

        <button type="submit" class="btn-submit">S'inscrire</button>
    </form>
</section>
{% endblock %}