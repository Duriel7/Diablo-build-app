{% extends "base.html.twig" %}

{% block title %}Profil de {{ user.nickname }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="card bg-dark text-white border-gold p-4">
        <div class="row align-items-center">
            <div class="col-md-3 text-center">
                <div class="avatar-container mb-3">
                    {% if user.avatarFileName != 'user.png' %}
                        <img src="/uploads/avatars/{{ user.avatarRepository }}/{{ user.avatarFileName }}" 
                             alt="Avatar" class="img-fluid rounded border border-warning" style="max-width: 150px;">
                    {% else %}
                        <img src="/assets/img/default-avatar.png" alt="Avatar" class="img-fluid rounded" style="max-width: 150px;">
                    {% endif %}
                </div>
            </div>
            
            <div class="col-md-9">
                <h1 class="text-gold">{{ user.nickname }} 
                    <small class="text-muted fs-6">(Inscrit le {{ user.registeredAt|date('d/m/Y') }})</small>
                </h1>
                <p class="badge bg-primary">{{ user.role|upper }}</p>
                <hr class="border-secondary">
                <p><strong>Ville :</strong> {{ user.city }} / Coordonnées : lat - {{user.latitude}} ; long - {{user.longitude}}</p>
                <p><strong>Bio :</strong> {{ user.bio ?: "Ce héros n'a pas encore écrit sa légende." }}</p>
                
                {% if isOwner %}
                    <a href="/profile/edit" class="btn btn-outline-warning btn-sm">Modifier mon profil</a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="mt-5">
        <h3 class="text-gold">Builds de ce Nephalem</h3>
    </div>
</div>
{% endblock %}